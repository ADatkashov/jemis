# Rendered by the nginx image entrypoint (envsubst only touches variables that are set in the environment,
# so nginx's own $uri / $remote_addr stay intact). BACKEND_URL defaults to the compose service.
server {
  listen 80;
  root /usr/share/nginx/html;

  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-For $remote_addr;
  }

  # Entry points must never be cached stale, otherwise users keep running an old build.
  location = /index.html { add_header Cache-Control "no-cache"; }
  location = /flutter_bootstrap.js { add_header Cache-Control "no-cache"; }
  location = /version.json { add_header Cache-Control "no-cache"; }

  # Client-side routes (/orders/42) fall back to the app shell.
  location / { try_files $uri /index.html; }
}
