# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# >= 32 bytes, random: openssl rand -base64 48
JEMIS_JWT_SECRET=
JEMIS_CORS_ORIGINS=http://localhost:8081
# First administrator, created only if no admin exists yet
JEMIS_BOOTSTRAP_ADMIN_EMAIL=
JEMIS_BOOTSTRAP_ADMIN_PASSWORD=
# Set to true only for local exploration of the API docs
JEMIS_OPENAPI_ENABLED=false
